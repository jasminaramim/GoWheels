# Server & Network Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# MongoDB connection string for MongoDB Atlas or local daemon
# If not provided, GoWheels operates with an in-memory transactional document engine
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/gowheels?retryWrites=true&w=majority"

# Security & Authentication
JWT_SECRET="gowheels_production_secret_key_jwt_signature_2026"

# Host URL
APP_URL="http://localhost:3000"
